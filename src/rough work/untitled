import { useNavigate } from "react-router-dom";
import { useContext, useEffect, useMemo, useState } from "react";
import { ProfileContext } from "../../context/profileContext.jsx";
import { Button } from "../../../LandingPage/Button/Button.jsx";
import { api } from "../../../Api/api.js";
import shield from "../../../public/pictures/image/shield.svg";
import taken from "../../../public/pictures/image/taken.svg";
import due from "../../../public/pictures/image/due.svg";
import overdue from "../../../public/pictures/image/overdue.svg";
import plus from "../../../public/pictures/image/plus.svg";
import edit from "../../../public/pictures/image/edit.svg";
import share from "../../../public/pictures/image/share.svg";
import chatBotIcon from "../../../public/pictures/image/chatBot.svg";
import "./DashBody.css";
import ChatBot from "../chatBot/chatBot.jsx";

const TEMP_REMINDERS_KEY = "temporaryDashboardReminders";

export function DashBody() {
  const navigate = useNavigate();
  const { profiles, profilesLoaded, activeProfile, setActiveProfile, dashboardRefreshKey } = useContext(ProfileContext);

  const [activeStatus, setActiveStatus] = useState("all");
  const [dashboardData, setDashboardData] = useState({ taken: [], due: [], overdue: [] });
  const [recommendations, setRecommendations] = useState([]);
  const [loadingDashboard, setLoadingDashboard] = useState(false);
  const [dashboardError, setDashboardError] = useState("");
  const [takenToggleByCard, setTakenToggleByCard] = useState({});
  const [chatVisible, setChatVisible] = useState(false);

  const selectedProfile = useMemo(
    () => profiles.find((p) => p.id === activeProfile) ?? null,
    [profiles, activeProfile]
  );

  const getFullName = (profile) =>
    [profile?.firstName, profile?.middleName, profile?.lastName].filter(Boolean).join(" ");

  const normalizeStatusItems = (items) =>
    Array.isArray(items)
      ? items.map((item, idx) => ({
          id: item?.vaccine_id ?? `${item?.Vaccine?.name ?? "vaccine"}-${idx}`,
          name: item?.Vaccine?.name ?? item?.name ?? "Vaccine",
          subtitle: item?.Vaccine?.age_range ?? item?.recommended_age ?? item?.status ?? "Vaccination record",
          status: item?.status ?? "",
        }))
      : [];

  const normalizeRecommendations = (payload) => {
    const source = payload?.data?.data ?? payload?.data ?? payload;
    const list = Array.isArray(source)
      ? source
      : Array.isArray(source?.recommendations)
      ? source.recommendations
      : [];
    return list.map((item, idx) => ({
      id: item?.recommendation_id ?? item?.vaccine_id ?? `recommendation-${idx}`,
      name: item?.Vaccine?.name ?? item?.name ?? item?.title ?? "Recommendation",
      subtitle: item?.message ?? item?.description ?? item?.reason ?? "Recommended for this profile",
    }));
  };

  const buildFallbackStatusItems = (count, status) =>
    Array.from({ length: Math.max(0, Number(count) || 0) }, (_, i) => ({
      id: `fallback-${status}-${i + 1}`,
      name: `Vaccine ${i + 1}`,
      subtitle: "Details unavailable",
      status,
    }));

  const buildFallbackDashboardData = (profile) => {
    const total = Number(profile?.total || 0);
    const due = Number(profile?.due || 0);
    const overdue = Number(profile?.overdue || 0);
    const taken = total - due - overdue;
    return { taken: buildFallbackStatusItems(taken, "taken"), due: buildFallbackStatusItems(due, "due"), overdue: buildFallbackStatusItems(overdue, "overdue") };
  };

  useEffect(() => { if (!activeProfile && profiles.length) setActiveProfile(profiles[0].id); }, [activeProfile, profiles, setActiveProfile]);

  useEffect(() => {
    let isMounted = true;
    const loadDashboardData = async () => {
      if (!activeProfile) return setDashboardData({ taken: [], due: [], overdue: [] });
      const token = window.localStorage.getItem("accessToken");
      if (!token) return setDashboardData({ taken: [], due: [], overdue: [] });

      setLoadingDashboard(true);

      const [dashboardResult, recommendationResult] = await Promise.allSettled([
        api.get(`/api/v1/dashboard/${activeProfile}`),
        api.get(`/api/v1/recommendations/${activeProfile}`)
      ]);

      if (!isMounted) return;

      if (dashboardResult.status === "fulfilled") {
        const payload = dashboardResult.value?.data?.data ?? {};
        setDashboardData({
          taken: normalizeStatusItems(payload?.taken),
          due: normalizeStatusItems(payload?.due),
          overdue: normalizeStatusItems(payload?.overdue)
        });
      } else {
        setDashboardData(buildFallbackDashboardData(selectedProfile));
      }

      if (recommendationResult.status === "fulfilled") setRecommendations(normalizeRecommendations(recommendationResult.value));
      else setRecommendations([]);

      setLoadingDashboard(false);
    };

    loadDashboardData();
    return () => { isMounted = false; };
  }, [activeProfile, dashboardRefreshKey, selectedProfile]);

  const allDashboardItemsWithTemporaryReminders = useMemo(() => {
    const tempDue = JSON.parse(window.localStorage.getItem(TEMP_REMINDERS_KEY) || "[]").filter((i) => i.profileId === activeProfile);
    return { ...dashboardData, due: [...dashboardData.due, ...tempDue] };
  }, [dashboardData, activeProfile]);

  const calculateAge = (birthDate) => {
    if (!birthDate) return "N/A";
    const today = new Date(), birth = new Date(birthDate);
    if (isNaN(birth)) return "N/A";
    let age = today.getFullYear() - birth.getFullYear();
    if (today.getMonth() < birth.getMonth() || (today.getMonth() === birth.getMonth() && today.getDate() < birth.getDate())) age--;
    return age >= 0 ? age : "N/A";
  };

  const getDisplayStatus = (status) => (status?.toLowerCase() === "due" ? "Due" : status?.toLowerCase() === "overdue" ? "Overdue" : "Taken");
  const getStatusIcon = (status) => (status?.toLowerCase() === "due" ? due : status?.toLowerCase() === "overdue" ? overdue : taken);
  const getActionLabel = (isTaken) => (isTaken ? "Mark as Not Taken" : "Mark as Taken");

  const renderDashboardCards = (items, keyPrefix, fallbackStatus) => (
    <ul className="dashboard-list">
      {items.map((item) => {
        const status = item?.status?.toLowerCase() || fallbackStatus || "taken";
        const displayStatus = getDisplayStatus(status);
        const cardKey = `${keyPrefix}-${item.id}`;
        const isTaken = takenToggleByCard[cardKey] ?? status === "taken";
        return (
          <li key={cardKey} className="dashboard-list-item">
            <div className="dashboard-card-content">
              <div className="dashboard-card-main">
                <div className="dashboard-card-title-row">
                  <h3 className="dashboard-vaccine-name">{item.name}</h3>
                  <p className="dashboard-badge">Compulsory</p>
                </div>
                <p className="dashboard-card-subtitle">{item.subtitle}</p>
                <div className="dashboard-card-footer">
                  <div className="dashboard-card-status">
                    <img src={getStatusIcon(status)} alt={`${displayStatus} status`} />
                    <p>{displayStatus}</p>
                  </div>
                </div>
              </div>
              <div className="dashboard-card-actions">
                <button
                  type="button"
                  className="dashboard-action-btn"
                  onClick={() => setTakenToggleByCard((prev) => ({ ...prev, [cardKey]: !isTaken }))}
                >
                  <span className={`dashboard-action-check ${isTaken ? "checked" : ""}`} aria-hidden="true">{isTaken ? "✓" : ""}</span>
                  <span className="dashboard-action-label">{getActionLabel(isTaken)}</span>
                </button>
                <button type="button" className="dashboard-remove-btn">Remove</button>
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  );

  if (!profilesLoaded) return null;
  if (!profiles.length)
    return (
      <div className="dash-body">
        <div className="body-wrapper">
          <img src={shield} alt="shield" />
          <div className="body-text">
            <h2>No Profiles Yet</h2>
            <p>Create a profile to start tracking vaccinations</p>
          </div>
          <button className="body-btn" onClick={() => navigate("/create-profile")}>Create Your First Profile</button>
        </div>
      </div>
    );

  return (
    <div className="dash-body" id="dash2">
      <div className="profile-grid">
        {/* LEFT SIDE: profiles list */}
        <div className="add-profile-btn">
          <div className="profile-header">
            <p>Profiles</p>
            <div className="header-img">
              <img src={share} alt="share button" />
              <img src={plus} alt="add profile" onClick={() => navigate("/create-profile")} />
            </div>
          </div>
          {profiles.map((profile) => (
            <div key={profile.id} className="profile-summary" onClick={() => setActiveProfile(activeProfile === profile.id ? null : profile.id)}>
              <div className="user-main">
                <div className="user-info-left">
                  <div className="dash-body-avatar">{profile?.firstName?.charAt(0).toUpperCase() || "U"}</div>
                  <div className="user-info">
                    <h4>{getFullName(profile)}</h4>
                    <p>{profile.category}</p>
                  </div>
                </div>
                <div className="user-edit">
                  <img src={edit} alt="edit symbol" onClick={(e) => { e.stopPropagation(); navigate(`/edit-profile/${profile.id}`); }} />
                </div>
              </div>
            </div>
          ))}
        </div>

        {/* RIGHT SIDE PROFILE CARD */}
        {profiles.map((profile) => {
          if (activeProfile !== profile.id) return null;
          return (
            <div key={profile.id} className="profile-card">
              <div id="profile-space">
                <h3>{profile?.firstName || "N/A"}</h3>
                <div className="profile-detail">
                  <p>{calculateAge(profile.date)} years • {profile.gender} • {profile.category}</p>
                </div>

                {/* Vaccine buttons */}
                <div className="profile-vaccine">
                  <div className="vaccine-item"><img src={taken} alt="taken vaccines" /><p>Taken ({allDashboardItemsWithTemporaryReminders.taken.length})</p></div>
                  <div className="vaccine-item"><img src={due} alt="due vaccines" /><p>Due ({allDashboardItemsWithTemporaryReminders.due.length})</p></div>
                  <div className="vaccine-item"><img src={overdue} alt="overdue vaccines" /><p>Overdue ({allDashboardItemsWithTemporaryReminders.overdue.length})</p></div>
                </div>

                {/* Chatbot icon */}
                <img src={chatBotIcon} alt="ChatBot" className="chatbot-icon" onClick={() => setChatVisible(true)} />
              </div>
            </div>
          );
        })}

        {/* STATUS BUTTONS */}
        <div className="status-btn">
          <Button text="My Vaccines" className={activeStatus === "all" ? "status active" : "status"} onClick={() => setActiveStatus("all")} />
          <Button text="Taken" className={activeStatus === "taken" ? "status active" : "status"} onClick={() => setActiveStatus("taken")} />
          <Button text="Due" className={activeStatus === "due" ? "status active" : "status"} onClick={() => setActiveStatus("due")} />
          <Button text="OverDue" className={activeStatus === "overdue" ? "status active" : "status"} onClick={() => setActiveStatus("overdue")} />
        </div>

        {/* VACCINE SECTION */}
        <div className="vaccine-section">
          {loadingDashboard && <p className="dashboard-meta">Loading dashboard data...</p>}
          {dashboardError && <p className="dashboard-meta error">{dashboardError}</p>}

          {activeStatus === "all" && (
            <div className="dashboard-group">
              {allDashboardItemsWithTemporaryReminders.length === 0
                ? <div className="no-vaccines-empty"><p>No vaccines in this category</p></div>
                : renderDashboardCards([...allDashboardItemsWithTemporaryReminders.due, ...allDashboardItemsWithTemporaryReminders.overdue, ...allDashboardItemsWithTemporaryReminders.taken], "all")
              }
              {recommendations.length > 0 && (
                <div className="dashboard-recommendations">
                  <p>Recommendations</p>
                  <ul className="dashboard-list">{recommendations.map((item) => <li key={item.id}><h3>{item.name}</h3><p>{item.subtitle}</p></li>)}</ul>
                </div>
              )}
            </div>
          )}
          {activeStatus === "taken" && renderDashboardCards(dashboardData.taken, "taken", "taken")}
          {activeStatus === "due" && renderDashboardCards(allDashboardItemsWithTemporaryReminders.due, "due", "due")}
          {activeStatus === "overdue" && renderDashboardCards(dashboardData.overdue, "overdue", "overdue")}
        </div>
      </div>

      {/* ChatBot Modal */}
      <ChatBot visible={chatVisible} onClose={() => setChatVisible(false)} />
    </div>
  );
}